# Copy this file to .env and fill in real values for local development.
# .env is gitignored - never commit it.

# --- General -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- NGINX ---------------------------------------------------------------
# Host port that proxies to the internal NGINX gateway on :80.
NGINX_PORT=8080

# --- PostgreSQL ------------------------------------------------------------
# Used by the postgres container itself and by the core service to build
# its connection string. Services connect via the "postgres" hostname on
# the Compose network - never localhost.
POSTGRES_USER=nool
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nool_core

# --- Firebase (Auth service) ---------------------------------------------
# Required for /ready and token verification to succeed. Leave blank for a
# clean `docker compose up --build` without real Firebase credentials -
# health/readiness for other checks still work, but token verification
# will fail until these are set.
FIREBASE_PROJECT_ID=
# Host path to an Admin SDK service account JSON (Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key).
# Bind-mounted read-only into auth/core - see compose.yml. Put the file
# under ./secrets/ (gitignored) and never commit it.
FIREBASE_CREDENTIALS_HOST_PATH=./secrets/firebase-service-account.json
# Web API key (Firebase Console -> Project Settings -> General -> Your
# apps -> Web API Key). Public by design - the same value each frontend
# already ships as NEXT_PUBLIC_FIREBASE_API_KEY - but also needed here
# now that POST /api/v1/login checks passwords server-side.
FIREBASE_WEB_API_KEY=

# --- Observability ---------------------------------------------------------
# Jaeger trace UI host port (compose.override.yml, local dev only) - see
# docs/OBSERVABILITY.md. Optional; defaults to 16686 if unset.
JAEGER_UI_PORT_HOST=16686

# --- Direct service access (compose.override.yml, local dev only) --------
# Host ports for reaching auth/core directly, bypassing NGINX - useful for
# hitting each service's OpenAPI/Swagger UI at /docs. Not published in the
# production-shaped compose.yml. Optional; default to 8001/8002 if unset.
AUTH_PORT_HOST=8001
CORE_PORT_HOST=8002
